# Шаблон окружения. Скопировать в .env и заполнить своими значениями.
# .env в .gitignore и имеет права 600 — секреты в git не попадают.

# Токен dev-бота MAX (@admtavda_ai_dev_bot), кабинет MAX для разработчиков
BOT_TOKEN=

# Ключ авторизации GigaChat API (Сбер): строка base64 от пары client_id:client_secret
# из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
